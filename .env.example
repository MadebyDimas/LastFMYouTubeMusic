# === Last.fm Settings ===
# Получить ключи: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_api_key_here
LASTFM_API_SECRET=your_api_secret_here

# Авторизация Last.fm (логин и пароль или session_key)
LASTFM_USERNAME=your_username
LASTFM_PASSWORD=your_password
# LASTFM_SESSION_KEY=your_session_key

# === Scrobbler Settings ===
# Интервал опроса истории YouTube Music в секундах (по умолчанию 30)
POLL_INTERVAL=30

# Процент прослушивания трека для скробблинга (0.2 = 20%)
SCROBBLE_PERCENTAGE=0.2

# Очищать мусор в названиях треков (Official Music Video, [Lyrics] и т.д.)
CLEAN_TITLES=true

# Минимальная длительность трека в секундах для скробблинга
MIN_TRACK_DURATION=30

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
